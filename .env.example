# Copy this file to .env and fill in your own values:  cp .env.example .env
# Both values are in Supabase: Project Settings → API (or "Connect").
# Leave them empty and the world counter runs in demo mode (browser only).

# Your project address, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLIC key: "publishable" (sb_publishable_...) or the legacy "anon" key.
# It is safe in the browser because Row Level Security protects the data.
# Never put the secret / service_role key here.
VITE_SUPABASE_KEY=sb_publishable_your-key-here
